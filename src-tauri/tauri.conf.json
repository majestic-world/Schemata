{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SchemataDb",
  "identifier": "dev.schematadb.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SchemataDb",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "maximized": true,
        "visible": false,
        "theme": "Light",
        "backgroundColor": "#f9fafb"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
